# Native / Synology-first runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TIME_ZONE=Europe/Warsaw
PUBLIC_URL=https://fit.qqnd.fyi
WEB_DIST_PATH=apps/web/dist
DATABASE_URL=file:./data/qnd-health.db

# Local browser login. WEB_USERNAME defaults to quendae if omitted.
WEB_USERNAME=quendae
WEB_PASSWORD=replace-with-a-strong-password

# API tokens are hashed with this server-side secret. It also signs browser sessions.
# Generate a long random value and keep it stable.
TOKEN_PEPPER=replace-with-a-long-random-secret

# Optional integrations
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
