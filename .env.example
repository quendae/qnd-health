# Runtime
NODE_ENV=production
TIME_ZONE=Europe/Warsaw
PUBLIC_URL=https://fit.qqnd.fyi
WEB_PORT=8080
API_PORT=3001

# PostgreSQL - replace the password before first start
POSTGRES_DB=qnd_health
POSTGRES_USER=qnd_health
POSTGRES_PASSWORD=replace-with-a-long-random-password

# API tokens are hashed with this server-side secret. Keep it stable and private.
TOKEN_PEPPER=replace-with-a-long-random-secret

# Optional integrations
DEEPSEEK_API_KEY=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Local non-Docker development only
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://qnd_health:qnd_health@localhost:5432/qnd_health?schema=public
WEB_ORIGIN=http://localhost:5173
